# Copy this file to .env.local, fill in your own values, and restart Next.js.
# Keep these values server-side. Never prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
# Use a sender on a domain verified in your Resend account, e.g.
# Muhammad Awais Portfolio <contact@your-verified-domain.com>
# This is the sender, NOT your Gmail recipient or the visitor's email.
CONTACT_FROM_EMAIL=
